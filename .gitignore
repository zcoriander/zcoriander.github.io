# ===== 敏感文件 —— 绝不提交 =====
# GitHub token / 密钥
github_token
github_token.*
*.token
*.tokens
*_token
*_token.*
.env
.env.*
!.env.example
secrets/
.local-secrets/
.local/
credentials/
*.pem
*.key
*.p12
id_rsa*
.netrc
.npmrc
.authinfo

# GitHub Actions 工作流
# 当前采用「分支直发 Pages」方案，无需 Actions。
# 备用 Actions 方案保存在 deploy/pages-actions.yml，
# 如需启用请同时给 token 添加 workflow scope，然后移回 .github/workflows/
.github/workflows/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/

# 采集缓存
/tmp/
*.cache

# 系统
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/
*.swp
